# Oceania Fertilizers website: environment variables.
# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables. Never commit real values.
# Everything is optional for local development: without services the site
# uses its bundled content and a local PGlite database in .data/.

# --- Site ---------------------------------------------------------------
# Public URL, used for canonical links, sitemaps and share images.
NEXT_PUBLIC_SITE_URL=https://oceaniafertilizers.com
# production | preview | development. Only "production" is indexable and
# hides content marked "pending". Vercel sets NEXT_PUBLIC_VERCEL_ENV, which is
# used when this is left empty.
NEXT_PUBLIC_SITE_ENV=

# --- Sanity CMS ---------------------------------------------------------
# From sanity.io/manage. Without a project id the site uses bundled content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Viewer token for draft previews in the Studio (server only).
SANITY_API_READ_TOKEN=
# Random string shared with the Sanity webhook that refreshes the site on publish.
SANITY_REVALIDATE_SECRET=
# Editor token used only by `npm run sanity:seed` on your own machine.
# Do not add this one to Vercel.
SANITY_API_WRITE_TOKEN=

# --- Lead storage (PostgreSQL) -------------------------------------------
# Neon connection string (pooled). Required in production; forms refuse to
# report success without a database.
DATABASE_URL=
# Local only: where PGlite keeps data when DATABASE_URL is empty ("memory" for none).
PGLITE_DATA_DIR=
# Random string (32+ characters) used to hash IP addresses for spam control.
IP_HASH_SALT=

# --- Email notifications (Resend) ---------------------------------------
RESEND_API_KEY=
# A sender on a domain verified in Resend, for example:
# Oceania website <website@send.oceaniafertilizers.com>
LEADS_NOTIFY_FROM=
# Comma-separated recipients for new leads.
LEADS_NOTIFY_TO=

# --- Spam protection (Cloudflare Turnstile, optional) --------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Leads admin (/admin) -----------------------------------------------
# The admin area is switched off unless both are set.
# Password: at least 12 characters. Secret: at least 32 random characters.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Analytics and search (optional) -------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# --- Tests only ---------------------------------------------------------
# Loads clearly labelled test fixtures. Never set on Vercel.
E2E_FIXTURES=
